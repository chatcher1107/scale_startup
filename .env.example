# Copy this file to .env.local and fill it in. Never commit .env.local (it is git-ignored).
#
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# Required for live AI. Without it the app still works in "mock mode".
OPENAI_API_KEY=paste-your-key-here

# Optional: model to use (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: a custom OpenAI-compatible endpoint (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1
